        "concentrations": [
          {"label": "1 mg/mL (1:1,000)", "mg_per_ml": 1.0},
          {"label": "0.1 mg/mL (1:10,000)", "mg_per_ml": 0.1}
        ],
        "indications": {
          "cardiac_arrest": {
            "routes": ["IV", "IO"],
            "adult": {"dose_min": 1, "dose_max": 1, "max_total": null, "max_doses": null, "min_repeat_interval_min": 3},
            "pediatric": {"per_kg": 0.01, "max_single": 1, "max_total": null, "max_doses": null, "min_repeat_interval_min": 3},
            "note": "Use 0.1 mg/mL. Repeat every 3-5 minutes.",
            "source": "nasemso_v3"
          },
          "anaphylaxis": {
            "routes": ["IM"],
            "adult": {"dose_min": 0.3, "dose_max": 0.5, "max_total": null, "max_doses": 3, "min_repeat_interval_min": 5},
            "pediatric": {"per_kg": 0.01, "max_single": 0.3, "max_total": null, "max_doses": 3, "min_repeat_interval_min": 5},
            "note": "Use 1 mg/mL IM (anterolateral thigh). Repeat every 5-15 minutes. Giving 1 mg/mL IV is a classic fatal error.",
            "source": "nasemso_v3"
          }
        },
        "contraindications": [],
        "dangerous_mismatches": [
          {"id": "EPI_CONC_ROUTE", "text": "1 mg/mL concentration given IV/IO", "concentration_mg_per_ml": 1.0, "routes": ["IV", "IO"]}
